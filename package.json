{
  "name": "nimia-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:www": "turbo run dev --filter=www",
    "dev:studio": "turbo run dev --filter=studio",
    "build": "turbo run build",
    "build:www": "turbo run build --filter=www",
    "build:studio": "turbo run build --filter=studio",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "overrides": {
    "zod": "3.24.1"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
