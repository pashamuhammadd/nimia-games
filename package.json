{
  "name": "nimia-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:www": "turbo run dev --filter=www",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:app": "turbo run dev --filter=app",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:portfolio": "turbo run dev --filter=portfolio",
    "dev:miniapp": "turbo run dev --filter=miniapp",
    "build": "turbo run build",
    "build:www": "turbo run build --filter=www",
    "build:studio": "turbo run build --filter=studio",
    "build:app": "turbo run build --filter=app",
    "build:admin": "turbo run build --filter=admin",
    "build:portfolio": "turbo run build --filter=portfolio",
    "build:miniapp": "turbo run build --filter=miniapp",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "zod": "3.24.1"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
